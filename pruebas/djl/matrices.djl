// matrices.djl - Producto de matrices C = A * B (arreglos y matrices)
#define N 3

int a[N][N];
int b[N][N];
int c[N][N];

void multiplicar() {
    int i;
    int j;
    int k;
    for (i = 0; i < N; i = i + 1) {
        for (j = 0; j < N; j = j + 1) {
            c[i][j] = 0;
            for (k = 0; k < N; k = k + 1) {
                c[i][j] = c[i][j] + a[i][k] * b[k][j];
            }
        }
    }
}

int main() {
    int i;
    int j;
    for (i = 0; i < N; i = i + 1) {
        for (j = 0; j < N; j = j + 1) {
            a[i][j] = i + j;
            b[i][j] = (i == j);          // matriz identidad
        }
    }
    multiplicar();
    print(c[2][1], c[N - 1][N - 1]);
    return 0;
}
