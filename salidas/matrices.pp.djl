// matrices.djl - Producto de matrices C = A * B (arreglos y matrices)


int a[3][3];
int b[3][3];
int c[3][3];

void multiplicar() {
    int i;
    int j;
    int k;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            c[i][j] = 0;
            for (k = 0; k < 3; k = k + 1) {
                c[i][j] = c[i][j] + a[i][k] * b[k][j];
            }
        }
    }
}

int main() {
    int i;
    int j;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            a[i][j] = i + j;
            b[i][j] = (i == j);          // matriz identidad
        }
    }
    multiplicar();
    print(c[2][1], c[3 - 1][3 - 1]);
    return 0;
}
